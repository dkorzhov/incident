# Пример переменных окружения (DMI-11). Скопируйте в `.env` и при необходимости поправьте.
# `.env` не коммитится (см. .gitignore); секретов в этом файле нет — только локальные заглушки.

# --- Backend ---------------------------------------------------------------
# Основная БД приложения.
DATABASE_URL=postgresql+psycopg://incident:incident@localhost:5432/incident
# Отдельная БД для тестов (`pytest`). Backend создаёт и мигрирует её при старте.
TEST_DATABASE_URL=postgresql+psycopg://incident:incident@localhost:5432/incident_test
# Origin'ы фронтенда через запятую — нужны только при работе без прокси.
CORS_ORIGINS=http://localhost:5173
# Демо-данные при старте (появится отдельным тикетом).
SEED_DEMO=false

# --- Frontend --------------------------------------------------------------
# Куда Vite-прокси отправляет `/api`. В compose — `http://backend:8000`.
# Без префикса VITE_: значение нужно только dev-серверу и не попадает в браузерный JS.
API_PROXY_TARGET=http://localhost:8000